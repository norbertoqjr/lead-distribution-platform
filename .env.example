# Local development database (docker compose).
# Copy to .env — .env is gitignored. These are local-only throwaway values;
# never reuse them on the server.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lead_distribution
MYSQL_USER=lead_user
MYSQL_PASSWORD=lead_password
MYSQL_PORT=3306

# Ports the dev servers bind to, mirroring production.
WEB_PORT=8192
API_PORT=8193

# Matching connection string for api/.env:
# DATABASE_URL=mysql://lead_user:lead_password@127.0.0.1:3306/lead_distribution
