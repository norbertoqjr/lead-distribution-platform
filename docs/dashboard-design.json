{
  "theme": {
    "mode": "light",
    "style": "modern-saas",
    "componentLibrary": "shadcn/ui",
    "borderStyle": "soft",
    "density": "comfortable"
  },
  "colors": {
    "background": "#F5F7F5",
    "foreground": "#101311",

    "card": "#FFFFFF",
    "cardForeground": "#101311",

    "popover": "#FFFFFF",
    "popoverForeground": "#101311",

    "primary": "#176B45",
    "primaryForeground": "#FFFFFF",

    "secondary": "#EEF4F0",
    "secondaryForeground": "#174F38",

    "muted": "#F1F4F2",
    "mutedForeground": "#8A948F",

    "accent": "#E6F2EB",
    "accentForeground": "#176B45",

    "destructive": "#E94F4F",
    "destructiveForeground": "#FFFFFF",

    "border": "#E6EBE8",
    "input": "#E6EBE8",
    "ring": "#176B45",

    "success": "#258657",
    "successForeground": "#FFFFFF",
    "successMuted": "#E6F5EC",

    "warning": "#E9B63C",
    "warningForeground": "#322400",
    "warningMuted": "#FFF6D9",

    "danger": "#E76767",
    "dangerForeground": "#FFFFFF",
    "dangerMuted": "#FDEAEA",

    "info": "#4379E8",
    "infoForeground": "#FFFFFF",
    "infoMuted": "#EAF0FF",

    "chart1": "#176B45",
    "chart2": "#258657",
    "chart3": "#64BC8B",
    "chart4": "#A5D8BA",
    "chart5": "#D7E8DE"
  },
  "gradients": {
    "primaryCard": "linear-gradient(145deg, #135D3C 0%, #1D7A4E 58%, #258657 100%)",
    "darkWidget": "linear-gradient(145deg, #062D1D 0%, #0B4A2E 55%, #176B45 100%)"
  },
  "typography": {
    "fontSans": [
      "Inter",
      "Geist",
      "ui-sans-serif",
      "system-ui",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "sans-serif"
    ],
    "fontMono": ["Geist Mono", "ui-monospace", "SFMono-Regular", "monospace"],
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "lineHeights": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.5
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "normal": "0em"
    },
    "usage": {
      "pageTitle": {
        "fontSize": "2.25rem",
        "fontWeight": 600,
        "lineHeight": 1.15,
        "letterSpacing": "-0.025em"
      },
      "sectionTitle": {
        "fontSize": "1.25rem",
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "cardTitle": {
        "fontSize": "1rem",
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "metricValue": {
        "fontSize": "3rem",
        "fontWeight": 500,
        "lineHeight": 1
      },
      "body": {
        "fontSize": "0.9375rem",
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "caption": {
        "fontSize": "0.75rem",
        "fontWeight": 400,
        "lineHeight": 1.4
      }
    }
  },
  "radius": {
    "sm": "0.625rem",
    "md": "0.875rem",
    "lg": "1.125rem",
    "xl": "1.5rem",
    "2xl": "1.75rem",
    "full": "9999px",
    "shadcnBase": "1rem"
  },
  "spacing": {
    "page": "1.5rem",
    "section": "1.25rem",
    "card": "1.25rem",
    "cardLarge": "1.5rem",
    "gridGap": "0.875rem",
    "controlGap": "0.75rem",
    "sidebarPadding": "1.25rem"
  },
  "shadows": {
    "none": "none",
    "card": "0 1px 2px rgba(16, 19, 17, 0.02), 0 8px 24px rgba(16, 19, 17, 0.025)",
    "floating": "0 12px 34px rgba(16, 19, 17, 0.08)",
    "button": "0 8px 18px rgba(23, 107, 69, 0.16)"
  },
  "layout": {
    "appShell": {
      "minHeight": "100dvh",
      "background": "#F5F7F5",
      "padding": "0.5rem",
      "desktopColumns": "16rem minmax(0, 1fr)",
      "gap": "0.5rem"
    },
    "sidebar": {
      "width": "16rem",
      "position": "fixed-on-desktop",
      "background": "#FFFFFF",
      "borderRadius": "1.5rem",
      "padding": "1.5rem 1rem",
      "border": "1px solid rgba(230, 235, 232, 0.75)",
      "display": "flex",
      "flexDirection": "column"
    },
    "main": {
      "minWidth": 0,
      "display": "flex",
      "flexDirection": "column",
      "gap": "0.5rem"
    },
    "topbar": {
      "height": "5.5rem",
      "background": "#FFFFFF",
      "borderRadius": "1.5rem",
      "padding": "0 1.5rem",
      "border": "1px solid rgba(230, 235, 232, 0.75)",
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "space-between"
    },
    "content": {
      "background": "#F8FAF8",
      "borderRadius": "1.5rem",
      "padding": "1.5rem",
      "minHeight": "calc(100dvh - 6.5rem)"
    },
    "container": {
      "maxWidth": "100%",
      "margin": "0 auto"
    }
  },
  "sidebar": {
    "logo": {
      "height": "2.5rem",
      "iconSize": "2rem",
      "fontSize": "1.25rem",
      "fontWeight": 600,
      "gap": "0.75rem",
      "marginBottom": "2.75rem"
    },
    "sectionLabel": {
      "fontSize": "0.75rem",
      "fontWeight": 500,
      "textTransform": "uppercase",
      "color": "#8A948F",
      "margin": "0 0.75rem 0.75rem"
    },
    "navigation": {
      "gap": "0.25rem"
    },
    "item": {
      "height": "2.875rem",
      "padding": "0 0.75rem",
      "borderRadius": "0.875rem",
      "fontSize": "0.9375rem",
      "fontWeight": 500,
      "iconSize": "1.25rem",
      "gap": "0.75rem",
      "inactiveColor": "#909A95",
      "hoverBackground": "#F3F6F4",
      "hoverColor": "#176B45"
    },
    "activeItem": {
      "background": "transparent",
      "color": "#101311",
      "fontWeight": 600,
      "indicator": {
        "position": "absolute",
        "left": "-1rem",
        "width": "0.375rem",
        "height": "2.5rem",
        "background": "#176B45",
        "borderRadius": "0 9999px 9999px 0"
      }
    },
    "badge": {
      "height": "1.25rem",
      "minWidth": "1.5rem",
      "padding": "0 0.375rem",
      "fontSize": "0.625rem",
      "fontWeight": 600,
      "borderRadius": "0.375rem",
      "background": "#174F38",
      "color": "#FFFFFF"
    }
  },
  "header": {
    "search": {
      "width": "min(24rem, 40vw)",
      "height": "3rem",
      "background": "#F6F7F6",
      "border": "1px solid transparent",
      "borderRadius": "1rem",
      "paddingLeft": "3rem",
      "paddingRight": "4rem",
      "fontSize": "0.875rem",
      "placeholderColor": "#A3AAA6",
      "focusBorder": "#BFD6C8",
      "focusRing": "0 0 0 3px rgba(23, 107, 69, 0.1)"
    },
    "shortcut": {
      "height": "1.75rem",
      "padding": "0 0.5rem",
      "borderRadius": "0.375rem",
      "background": "#E9EBEA",
      "color": "#626A66",
      "fontSize": "0.75rem"
    },
    "iconButton": {
      "size": "3rem",
      "borderRadius": "9999px",
      "background": "#FFFFFF",
      "border": "1px solid #EEF0EF",
      "iconSize": "1.25rem"
    },
    "profile": {
      "avatarSize": "3rem",
      "gap": "0.75rem",
      "nameFontSize": "0.9375rem",
      "nameFontWeight": 600,
      "metaFontSize": "0.8125rem",
      "metaColor": "#8A948F"
    }
  },
  "pageHeader": {
    "display": "flex",
    "alignItems": "flex-start",
    "justifyContent": "space-between",
    "gap": "1rem",
    "marginBottom": "1.25rem",
    "subtitleColor": "#9AA39E",
    "subtitleMarginTop": "0.5rem"
  },
  "grid": {
    "desktopColumns": 12,
    "gap": "0.875rem",
    "statistics": {
      "columns": 4,
      "cardMinHeight": "10.5rem"
    },
    "contentRows": {
      "analytics": {
        "span": 6
      },
      "reminder": {
        "span": 3
      },
      "projectList": {
        "span": 3,
        "rowSpan": 2
      },
      "team": {
        "span": 5
      },
      "progress": {
        "span": 4
      }
    },
    "responsive": {
      "xl": 12,
      "lg": 8,
      "md": 2,
      "sm": 1
    }
  },
  "card": {
    "background": "#FFFFFF",
    "foreground": "#101311",
    "border": "1px solid rgba(230, 235, 232, 0.65)",
    "borderRadius": "1.5rem",
    "padding": "1.25rem",
    "shadow": "0 1px 2px rgba(16, 19, 17, 0.02)",
    "headerGap": "0.375rem",
    "contentPaddingTop": "1rem",
    "hover": {
      "transform": "translateY(-1px)",
      "shadow": "0 8px 28px rgba(16, 19, 17, 0.045)",
      "transition": "180ms ease"
    }
  },
  "statCard": {
    "padding": "1.25rem",
    "borderRadius": "1.5rem",
    "display": "flex",
    "flexDirection": "column",
    "justifyContent": "space-between",
    "title": {
      "fontSize": "1rem",
      "fontWeight": 500
    },
    "value": {
      "fontSize": "3rem",
      "fontWeight": 500,
      "letterSpacing": "-0.04em",
      "marginTop": "1rem"
    },
    "meta": {
      "fontSize": "0.75rem",
      "color": "#6D8979",
      "display": "flex",
      "alignItems": "center",
      "gap": "0.375rem"
    },
    "action": {
      "size": "2.5rem",
      "borderRadius": "9999px",
      "border": "1px solid #2A342F",
      "iconSize": "1.125rem"
    },
    "featured": {
      "background": "linear-gradient(145deg, #135D3C 0%, #1D7A4E 58%, #258657 100%)",
      "foreground": "#FFFFFF",
      "border": "none",
      "metaColor": "#BFE58B",
      "actionBackground": "#FFFFFF",
      "actionForeground": "#101311",
      "actionBorder": "none"
    }
  },
  "button": {
    "defaultHeight": "3rem",
    "smallHeight": "2.25rem",
    "largeHeight": "3.25rem",
    "borderRadius": "9999px",
    "fontSize": "0.875rem",
    "fontWeight": 500,
    "paddingX": "1.5rem",
    "iconSize": "1rem",
    "gap": "0.5rem",
    "variants": {
      "default": {
        "background": "#176B45",
        "foreground": "#FFFFFF",
        "hoverBackground": "#145C3C",
        "shadow": "0 8px 18px rgba(23, 107, 69, 0.14)"
      },
      "outline": {
        "background": "#FFFFFF",
        "foreground": "#174F38",
        "border": "1px solid #3E715B",
        "hoverBackground": "#F3F8F5"
      },
      "secondary": {
        "background": "#EEF4F0",
        "foreground": "#174F38",
        "hoverBackground": "#E2ECE6"
      },
      "ghost": {
        "background": "transparent",
        "foreground": "#52605A",
        "hoverBackground": "#F0F4F2"
      }
    }
  },
  "input": {
    "height": "3rem",
    "borderRadius": "0.875rem",
    "background": "#FFFFFF",
    "border": "1px solid #E2E8E4",
    "fontSize": "0.875rem",
    "focusRing": "0 0 0 3px rgba(23, 107, 69, 0.12)"
  },
  "badge": {
    "height": "1.375rem",
    "padding": "0 0.5rem",
    "borderRadius": "0.375rem",
    "fontSize": "0.625rem",
    "fontWeight": 500,
    "variants": {
      "success": {
        "background": "#E7F4EC",
        "foreground": "#43815F",
        "border": "1px solid #C9E5D4"
      },
      "warning": {
        "background": "#FFF7E0",
        "foreground": "#C59626",
        "border": "1px solid #F4E2AA"
      },
      "danger": {
        "background": "#FDECEC",
        "foreground": "#C96C6C",
        "border": "1px solid #F2D0D0"
      },
      "neutral": {
        "background": "#F0F3F1",
        "foreground": "#6F7974",
        "border": "1px solid #E1E6E3"
      }
    }
  },
  "avatar": {
    "size": "2.75rem",
    "smallSize": "2rem",
    "largeSize": "3rem",
    "borderRadius": "9999px",
    "border": "2px solid #FFFFFF",
    "fallbackBackground": "#E7F1EB",
    "fallbackForeground": "#176B45"
  },
  "charts": {
    "fontFamily": "Inter",
    "labelColor": "#A0A8A4",
    "gridColor": "#EDF0EE",
    "tooltip": {
      "background": "#FFFFFF",
      "foreground": "#101311",
      "border": "1px solid #E6EBE8",
      "borderRadius": "0.75rem",
      "shadow": "0 10px 30px rgba(16, 19, 17, 0.08)"
    },
    "barChart": {
      "barWidth": "3.75rem",
      "barRadius": "9999px",
      "gap": "1.25rem",
      "activeColors": ["#258657", "#64BC8B", "#0E4D31"],
      "inactiveFill": "#F7F9F8",
      "inactiveStroke": "#9FAAA4",
      "inactivePattern": "diagonal-stripes"
    },
    "radialChart": {
      "track": "#EEF1EF",
      "completed": "#258657",
      "inProgress": "#0E4D31",
      "pending": "#B8C1BC",
      "strokeWidth": 22,
      "roundedCaps": true
    }
  },
  "list": {
    "rowMinHeight": "3.25rem",
    "rowGap": "0.75rem",
    "titleFontSize": "0.875rem",
    "titleFontWeight": 500,
    "metaFontSize": "0.6875rem",
    "metaColor": "#A0A8A4",
    "divider": "none"
  },
  "timeTracker": {
    "background": "linear-gradient(145deg, #062D1D 0%, #0B4A2E 55%, #176B45 100%)",
    "foreground": "#FFFFFF",
    "borderRadius": "1.5rem",
    "padding": "1.25rem",
    "timerFontSize": "2.25rem",
    "timerFontWeight": 500,
    "controls": {
      "size": "2.75rem",
      "borderRadius": "9999px",
      "pauseBackground": "#FFFFFF",
      "pauseForeground": "#176B45",
      "stopBackground": "#E84545",
      "stopForeground": "#FFFFFF"
    }
  },
  "motion": {
    "durationFast": "150ms",
    "durationDefault": "200ms",
    "durationSlow": "300ms",
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "cardHoverTranslateY": "-1px",
    "buttonActiveScale": 0.98
  },
  "responsive": {
    "desktop": {
      "minWidth": "1280px",
      "sidebarVisible": true,
      "statisticsColumns": 4
    },
    "tablet": {
      "minWidth": "768px",
      "maxWidth": "1279px",
      "sidebarMode": "collapsible",
      "statisticsColumns": 2,
      "contentColumns": 2
    },
    "mobile": {
      "maxWidth": "767px",
      "sidebarMode": "sheet",
      "pagePadding": "1rem",
      "statisticsColumns": 1,
      "contentColumns": 1,
      "topbarHeight": "4.5rem",
      "hideProfileMetadata": true
    }
  },
  "shadcn": {
    "cssVariables": {
      "--background": "120 11% 96%",
      "--foreground": "140 9% 7%",
      "--card": "0 0% 100%",
      "--card-foreground": "140 9% 7%",
      "--popover": "0 0% 100%",
      "--popover-foreground": "140 9% 7%",
      "--primary": "153 65% 25%",
      "--primary-foreground": "0 0% 100%",
      "--secondary": "140 18% 95%",
      "--secondary-foreground": "153 56% 20%",
      "--muted": "140 12% 95%",
      "--muted-foreground": "145 6% 56%",
      "--accent": "145 31% 93%",
      "--accent-foreground": "153 65% 25%",
      "--destructive": "0 78% 61%",
      "--destructive-foreground": "0 0% 100%",
      "--border": "140 11% 91%",
      "--input": "140 11% 91%",
      "--ring": "153 65% 25%",
      "--chart-1": "153 65% 25%",
      "--chart-2": "151 57% 34%",
      "--chart-3": "148 43% 56%",
      "--chart-4": "145 44% 75%",
      "--chart-5": "143 24% 88%",
      "--radius": "1rem"
    },
    "componentOverrides": {
      "Card": "rounded-3xl border-border/60 bg-card shadow-[0_1px_2px_rgba(16,19,17,0.02)]",
      "CardHeader": "space-y-1 p-5",
      "CardContent": "p-5 pt-0",
      "CardFooter": "p-5 pt-0",
      "Button": "rounded-full font-medium",
      "Input": "h-12 rounded-xl border-border bg-background",
      "Badge": "rounded-md px-2 py-0.5 text-[10px] font-medium",
      "Avatar": "ring-2 ring-background",
      "SheetContent": "rounded-l-3xl border-border",
      "DropdownMenuContent": "rounded-xl border-border shadow-lg",
      "DialogContent": "rounded-3xl border-border",
      "Table": "text-sm",
      "TabsList": "rounded-full bg-muted p-1",
      "TabsTrigger": "rounded-full"
    }
  },
  "implementationRules": [
    "Use shadcn/ui components as the base for buttons, cards, inputs, avatars, badges, dropdowns, sheets, dialogs, tabs, tables, tooltips and popovers.",
    "Do not use a separate custom design system when an equivalent shadcn component exists.",
    "Use CSS variables for theme colors so the theme can be changed globally.",
    "Use Tailwind utility classes for layout and component composition.",
    "Use Lucide React for all interface icons.",
    "Use Recharts for analytics charts.",
    "Use rounded-3xl for primary dashboard cards.",
    "Use rounded-full for primary actions, secondary actions and circular icon buttons.",
    "Keep borders subtle and avoid dark card outlines.",
    "Avoid strong drop shadows. Use borders, background contrast and very soft shadows for hierarchy.",
    "Use the primary green only for actions, selected states, chart emphasis and important metrics.",
    "Use neutral white cards against a slightly green-tinted page background.",
    "Keep card padding between 20px and 24px.",
    "Keep grid gaps between 14px and 20px.",
    "Do not hardcode user names, company names, project names, counts, emails or dashboard copy from the reference image.",
    "Treat all visible content as placeholder data supplied by the application.",
    "Do not copy the reference logo or brand identity.",
    "Do not include marketing descriptions, product names or site descriptions in the theme configuration.",
    "Build reusable dashboard primitives instead of one large page component.",
    "Recommended primitives are AppShell, SidebarNav, Topbar, PageHeader, StatCard, DashboardCard, ChartCard, MemberList, ProgressCard, TaskList and TimerCard.",
    "Ensure keyboard focus is visible using the primary ring color.",
    "Maintain WCAG-friendly contrast for text, buttons and status badges.",
    "On mobile, move the sidebar into a shadcn Sheet and stack all dashboard cards into one column."
  ]
}
